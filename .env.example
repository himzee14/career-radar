# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings > API). Never commit .env.local.
#
# There is no login in this app, so there's no user session for Row Level
# Security to check against. Instead, the server uses the SERVICE ROLE key
# below, which bypasses RLS by design — this key is powerful and must
# never have the NEXT_PUBLIC_ prefix, must never appear in any file under
# src/components or any "use client" file, and must never be logged or
# committed. It only belongs in Vercel's Environment Variables and in this
# local file (which .gitignore keeps out of git).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
