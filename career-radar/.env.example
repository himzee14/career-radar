# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings > API). Never commit .env.local.
#
# Note there is no service role key here on purpose — this app never uses
# it. All access goes through the anon key and is enforced by the Row
# Level Security policies in supabase/schema.sql.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
